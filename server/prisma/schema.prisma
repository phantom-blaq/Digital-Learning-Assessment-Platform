generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  CARD
  URL
  DOCUMENT
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String
}

model Source {
  id         String        @id @default(uuid())
  profileId  String
  title      String?
  type       SourceType
  body       String?
  url        String?
}